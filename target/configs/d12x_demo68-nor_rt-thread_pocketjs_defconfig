CONFIG_PRJ_DEFCONFIG_FILENAME="d12x_demo68-nor_rt-thread_pocketjs_defconfig"
CONFIG_PRJ_CHIP="d12x"
CONFIG_PRJ_BOARD="demo68-nor"
CONFIG_PRJ_KERNEL="rt-thread"
CONFIG_PRJ_APP="pocketjs"
# CONFIG_AIC_USING_FS_IMAGE_0 is not set
# FAT rodata image: data.fatfs mounts /rodata read-only
# CONFIG_AIC_USING_FS_IMAGE_TYPE_FATFS_FOR_0 is not set
# CONFIG_AIC_FS_IMAGE_DIR_0 is not set
# CONFIG_AIC_FS_IMAGE_NAME_0 is not set
CONFIG_AIC_USING_UART0=y
CONFIG_AIC_USING_UART1=y
CONFIG_AIC_USING_I2C0=y
CONFIG_AIC_USING_CAN0=y
CONFIG_AIC_USING_QSPI0=y
# XIP: QSPI0 serves the 0x60000000 execution window, so the OS must not
# attach a spinor device to it at runtime (per doc/topics/sdk/xip)
# CONFIG_AIC_QSPI0_DEVICE_SPINOR is not set
CONFIG_AIC_USING_TSEN=y
CONFIG_AIC_USING_TSEN_CPU=y
CONFIG_AIC_PRGB_24BIT=y
CONFIG_DATA_ORDER_BGR=y
CONFIG_AIC_DEGREE_0=y
CONFIG_AICFB_RGB565=y
CONFIG_AIC_PAN_DISPLAY=y
CONFIG_AIC_PANEL_480X272_RESOLUTION=y
CONFIG_AIC_PANEL_ENABLE_GPIO="PE.13"
CONFIG_AIC_GE_CMDQ=y
CONFIG_AIC_USING_DMA=y
CONFIG_AIC_USING_WRI=y
CONFIG_AIC_USING_WDT=y
CONFIG_AIC_PSRAM_SW_SIZE=0x700000
# XIP: .text/.rodata execute from the SPI NOR window; XIP_FW_OFFSET is the
# os partition offset (0x100000) plus the fixed 0x800 ITB header
CONFIG_AIC_XIP=y
CONFIG_AIC_XIP_FW_OFFSET=0x100800
CONFIG_AIC_INTERRUPTSTACK_SIZE=8192
CONFIG_AIC_CLK_PLL_FRA0_FREQ=384000000
CONFIG_AIC_USING_SID=y
CONFIG_AIC_SYSCFG_LDO1X_ENABLE=y
CONFIG_AIC_SYSCFG_LDO1X_VOL_VAL=8
CONFIG_AIC_USING_MTOP=y
CONFIG_IDLE_THREAD_STACK_SIZE=1024
# CONFIG_RT_KSERVICE_USING_STDLIB is not set
# CONFIG_RT_DEBUG is not set
CONFIG_RT_MEMHEAP_BSET_MODE=y
# Unified TLSF system heap (bsp/artinchip/drv/mem/rt_tlsf_heap.c) shared by
# the system and the PocketJS/QuickJS guest; RT_USING_MEMHEAP stays on for
# the framebuffer CMA region registered in board.c (mpp_mem routes through
# aic_memheap_* for it)
CONFIG_RT_USING_MEMHEAP=y
CONFIG_RT_USING_USERHEAP=y
# CONFIG_RT_USING_SMALL_MEM_AS_HEAP is not set
# CONFIG_RT_USING_MEMHEAP_AS_HEAP is not set
# CONFIG_RT_USING_SLAB_AS_HEAP is not set
# CONFIG_RT_USING_NOHEAP is not set
CONFIG_RT_CONSOLE_DEVICE_NAME="uart0"
CONFIG_RT_MAIN_THREAD_STACK_SIZE=4096
CONFIG_RT_USING_LEGACY=y
CONFIG_FINSH_HISTORY_LINES=1
CONFIG_DFS_FILESYSTEMS_MAX=8
CONFIG_RT_USING_DFS_MNTTABLE=y
CONFIG_RT_USING_DFS_ELMFAT=y
CONFIG_RT_DFS_ELM_LFN_UNICODE_2=y
CONFIG_RT_DFS_ELM_USE_EXFAT=y
CONFIG_RT_DFS_ELM_DRIVES=4
CONFIG_RT_DFS_ELM_MAX_SECTOR_SIZE=4096
CONFIG_RT_USING_DFS_DEVFS=y
CONFIG_RT_USING_DFS_ROMFS=y
# XIP: no runtime flash access — FAL/SFUD and the spinor-backed userid
# partition are out of the OS picture while QSPI0 is the execution window
# CONFIG_RT_USING_FAL is not set
# CONFIG_FAL_USING_SFUD_PORT is not set
CONFIG_RT_USING_ADC=y
CONFIG_RT_USING_PWM=y
CONFIG_RT_USING_PM=y
CONFIG_PM_USING_CUSTOM_CONFIG=y
CONFIG_PM_ENABLE_SUSPEND_SLEEP_MODE=y
CONFIG_PM_ENABLE_THRESHOLD_SLEEP_MODE=y
CONFIG_RT_MMCSD_STACK_SIZE=8192
# CONFIG_RT_SFUD_USING_QSPI is not set
CONFIG_RT_USING_TOUCH=y
CONFIG_RT_TOUCH_PIN_IRQ=y
CONFIG_RT_USING_ULOG=y
CONFIG_ULOG_OUTPUT_LVL_I=y
CONFIG_ULOG_TIME_USING_TIMESTAMP=y
CONFIG_ULOG_USING_FILTER=y
CONFIG_LPKG_USING_CPU_USAGE=y
# CONFIG_LPKG_USING_LITTLEFS is not set
CONFIG_AIC_MPP_PLAYER_INTERFACE=y
CONFIG_AIC_MPP_PLAYER_VIDEO_EXT_RENDER=y
# CONFIG_LPKG_USING_USERID is not set
# CONFIG_USERID_IN_SPINOR is not set
CONFIG_AIC_GPIO_IRQ_DRV_EN=y
CONFIG_AIC_USING_TOUCH=y
CONFIG_AIC_TOUCH_PANEL_I2C_CHAN="i2c0"
CONFIG_AIC_TOUCH_PANEL_RST_PIN="PA.10"
CONFIG_AIC_TOUCH_PANEL_INT_PIN="PA.11"
# CONFIG_AIC_FB_DRV_DEBUG is not set
CONFIG_PRJ_RV_TOOLCHAIN_UPSTREAM=y
