Import('AIC_ROOT')
Import('PRJ_KERNEL')
Import('rtconfig')
from building import *

cwd = GetCurrentDir()
src = Glob('*.c')
CPPPATH = []
LOCAL_CPPPATH = []
wifi_name = ''

LOCAL_CPPPATH.append(cwd + '/../../../../kernel/freertos/include/')
CPPPATH.append(cwd + '/os/wlan_lwip/')
LOCAL_CPPPATH.append(cwd + '/../../../../packages/third-party/lwip/src/include/')
LOCAL_CPPPATH.append(cwd + '/../../../../packages/third-party/lwip/')
LOCAL_CPPPATH.append(cwd + '/../../../../packages/third-party/lwip/contrib/ports/rt-thread/include')
LOCAL_CPPPATH.append(cwd + '/include/')
LOCAL_CPPPATH.append(cwd + '/api/')
LOCAL_CPPPATH.append(cwd + '/os/customer_rtos/')
LOCAL_CPPPATH.append(cwd + '/os/os_dep/include/')
LOCAL_CPPPATH.append(cwd + '/platform/include/')
LOCAL_CPPPATH.append(cwd + '/platform/rtwlan_bsp/')

if GetDepend('REALTEK_FULL_FNC_MODE'):
    LOCAL_CPPPATH.append(cwd + '/api/wifi/rtw_wpa_supplicant/src/')
    LOCAL_CPPPATH.append(cwd + '/api/wifi/rtw_wpa_supplicant/wpa_supplicant/')

if GetDepend('REALTEK_WLAN_INTF_SDIO'):
    LOCAL_CPPPATH.append(cwd + '/platform/sdio/include/')
    LOCAL_CPPPATH.append(cwd + '/platform/sdio/')

src += Glob('api/*.c')
src += Glob('api/wifi/*.c')

if GetDepend('REALTEK_FULL_FNC_MODE'):
    src += Glob('api/wifi/rtw_wpa_supplicant/wpa_supplicant/*.c')

src += Glob('os/customer_rtos/customer_rtt_service.c')
src += Glob('os/os_dep/*.c')

# Third-party packages LwIP using wlan_lwip/*
if GetDepend('LPKG_USING_LWIP') or GetDepend('RT_USING_LWIP'):
    src += Glob('os/wlan_lwip/*.c')
    LOCAL_CPPPATH.append(cwd + '/os/wlan_lwip/')

# RT-thread LwIP using adapt_to_rtt/*
if GetDepend('RT_USING_LWIP'):
    src += Glob('os/adapt_to_rtt/*.c')
    LOCAL_CPPPATH.append(cwd + '/os/adapt_to_rtt/')

src += Glob('platform/rtwlan_bsp/*.c')
if GetDepend('REALTEK_WLAN_INTF_SDIO'):
    src += Glob('platform/sdio/*.c')
    src += Glob('platform/sdio/core/*.c')

if GetDepend('REALTEK_WLAN_INTF_USB'):
    src += Glob('platform/usb /*.c')

if GetDepend('AIC_USING_RTL8733_WLAN0'):
    wifi_name = 'rtl8733'
if GetDepend('AIC_USING_RTL8189_WLAN0'):
    wifi_name = 'rtl8189'

if GetDepend('REALTEK_FULL_FNC_MODE'):
    lib_name = 'wlan_' + wifi_name + '_full_'+ rtconfig.CPUNAME
else:
    lib_name = 'wlan_' + wifi_name + '_'+ rtconfig.CPUNAME

LIBS = [lib_name]
LIBPATH = [cwd + "/wlan_lib/"]

myccflags = (' -w')

group = DefineGroup(wifi_name, src, depend = ['AIC_WLAN_REALTEK'], CPPPATH = CPPPATH, LOCAL_CPPPATH = LOCAL_CPPPATH, LIBS=LIBS, LIBPATH=LIBPATH, LOCAL_CFLAGS=myccflags)

Return('group')
